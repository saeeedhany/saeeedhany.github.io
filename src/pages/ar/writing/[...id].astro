---
import { render } from 'astro:content';
import Essay from '../../../layouts/Essay.astro';
import { postPaths, plateFor, postCanonical } from '../../../data/posts';

// Every post, Arabic chrome. Its English-chrome twin is /writing/[...id].
export const getStaticPaths = postPaths;

const { post, rank, number } = Astro.props;
const { Content } = await render(post);
---

<Essay
  lang="ar"
  contentLang={post.data.lang}
  title={post.data.title}
  date={post.data.date}
  description={post.data.description}
  tags={[...post.data.tags]}
  plate={plateFor(post, rank)}
  index={number}
  canonical={postCanonical(post)}
>
  <Content />
</Essay>
