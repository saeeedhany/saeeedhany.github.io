---
import Base from './Base.astro';
import Plate from '../components/Plate.astro';
import { COPY, baseFor, dirFor, fmtDate, type Lang } from '../data/site';

interface Props {
  /** the SITE language: navigation, footer, labels. Stays whatever the reader chose. */
  lang: Lang;
  /** the POST's language: its title, description, tags and body */
  contentLang: Lang;
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  plate?: string;
  index?: string;
  canonical?: string;
}

const { lang, contentLang, title, date, description, tags = [], plate, index, canonical } = Astro.props;
const t = COPY[lang];
const base = baseFor(lang);
const cdir = dirFor(contentLang);
---

<!--
  Two languages on one page, on purpose. An Arabic essay read from the English
  site keeps the English navigation, and vice versa — the reader changes the
  site language, not the post they open.

  Everything the POST wrote carries lang/dir of its own, which is all the type
  system keys off: the [lang='ar'] rules in type.css switch the display and
  reading faces, leading, size and tracking for that subtree only.
-->
<Base lang={lang} title={title} description={description} navSurface="ink" canonical={canonical} translated={false}>
  <article>
    <header class="band band--tight s-ink">
      <div class="container">
        <p class="essay__meta chrome" style="margin-block-end: var(--s-xl)">
          {index && <span>#{index}</span>}
          <span>{fmtDate(date)}</span>
          <span class="lang-badge">{contentLang}</span>
        </p>

        <div class="essay__head" lang={contentLang} dir={cdir}>
          <h1 class="display display--heading">{title}</h1>
          {description && <p class="read read--lead" style="opacity:.85">{description}</p>}
        </div>

        {
          tags.length > 0 && (
            <div class="tags" style="margin-block-start: var(--s-xl)" lang={contentLang} dir={cdir}>
              {tags.map((tag) => (
                <a
                  class="pill chrome chrome--info chrome--intl"
                  href={`${base}/writing?tag=${encodeURIComponent(tag)}`}
                >
                  {tag}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="band s-paper">
      <div class="container">
        {
          plate && (
            <div style="margin-block-end: var(--s-4xl)">
              <Plate name={plate} lang={lang} shape="wide" credit={true} alt="" />
            </div>
          )
        }

        <div class="prose essay__body" style="margin-block-start: 0" lang={contentLang} dir={cdir}>
          <slot />
        </div>

        <p style="margin-block-start: var(--s-4xl)">
          <a class="btn btn--outline" href={`${base}/writing`}>{t.readAll}</a>
        </p>
      </div>
    </div>
  </article>
</Base>
