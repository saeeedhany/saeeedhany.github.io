---
import Base from './Base.astro';
import Plate from '../components/Plate.astro';
import { COPY, baseFor, fmtDate, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  plate?: string;
  index?: string;
  kicker?: string;
}

const { lang, title, date, description, tags = [], plate, index, kicker } = Astro.props;
const t = COPY[lang];
const base = baseFor(lang);
---

<Base lang={lang} title={title} description={description} navSurface="ink">
  <!-- head band on ink, body on paper: the reading surface is the paper one -->
  <article>
    <header class="band band--tight s-ink">
      <div class="container">
        <p class="essay__meta chrome" style="margin-block-end: var(--s-xl)">
          {index && <span>#{index}</span>}
          {kicker && <span class="chrome--intl">{kicker}</span>}
          <span>{fmtDate(date)}</span>
          <span>{lang.toUpperCase()}</span>
        </p>

        <div class="essay__head">
          <h1 class="display display--heading" dir="auto">{title}</h1>
          {description && <p class="read read--lead" style="opacity:.85">{description}</p>}
        </div>

        {
          tags.length > 0 && (
            <div class="tags" style="margin-block-start: var(--s-xl)">
              {tags.map((tag) => (
                <span class="pill chrome chrome--info chrome--intl">{tag}</span>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="band s-paper">
      <div class="container">
        {
          plate && (
            <div style="margin-block-end: var(--s-4xl)">
              <Plate name={plate} lang={lang} shape="wide" credit={true} alt="" />
            </div>
          )
        }

        <div class="prose essay__body" style="margin-block-start: 0">
          <slot />
        </div>

        <p style="margin-block-start: var(--s-4xl)">
          <a class="btn btn--outline" href={`${base}/writing`}>{t.readAll}</a>
        </p>
      </div>
    </div>
  </article>
</Base>
