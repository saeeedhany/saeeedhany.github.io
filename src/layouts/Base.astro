---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/type.css';
import '../styles/components.css';

import Nav from '../components/Nav.astro';
import StickyNav from '../components/StickyNav.astro';
import Footer from '../components/Footer.astro';
import Menu from '../components/Menu.astro';
import Search from '../components/Search.astro';
import { ClientRouter } from 'astro:transitions';
import { COPY, SITE, THEMES, switchLangPath, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** surface of the first band, so the nav can invert to match */
  navSurface?: 'ink' | 'paper';
  /** absolute path to prefer in search results, when this page is a copy */
  canonical?: string;
  /** false when the other-language page is the same text in different chrome
   *  (posts), so it must not be announced as a translation */
  translated?: boolean;
}

const { lang, title, description, navSurface = 'ink', canonical, translated = true } = Astro.props;
// the same page in the other language — the switch never drops you on home
const altHref = switchLangPath(Astro.url.pathname, lang);
const siteUrl = Astro.site ?? 'https://saeeedhany.github.io';
const t = COPY[lang];
const fullTitle = title ? `${title} — ${SITE.name[lang]}` : SITE.name[lang];
const inks = Object.fromEntries(THEMES.map((th) => [th.id, th.ink]));
---

<!doctype html>
<html lang={lang} dir={t.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- in-page navigation, so the audio player survives page changes.
         fallback="swap": browsers without the View Transitions API get an
         instant swap instead of Astro's simulated animation. -->
    <ClientRouter fallback="swap" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content={THEMES[0].ink} />
    <script is:inline define:vars={{ inks }}>
      try {
        var saved = localStorage.getItem('theme');
        if (saved && inks[saved]) {
          document.documentElement.setAttribute('data-theme', saved);
          document.querySelector('meta[name="theme-color"]').setAttribute('content', inks[saved]);
        }
      } catch (e) {}
    </script>
    <link rel="canonical" href={new URL(canonical ?? Astro.url.pathname, siteUrl)} />
    {translated && <link rel="alternate" hreflang={lang === 'ar' ? 'en' : 'ar'} href={new URL(altHref, siteUrl)} />}
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
  </head>

  <body>
    <!-- the fixed ink border drawn over everything -->
    <div class="frame" aria-hidden="true"></div>

    <!--
      The footer sits OUTSIDE .page and is fixed behind it. .page reserves a
      gap of exactly --footer-h at its end; scrolling into that gap slides the
      content up off the footer and uncovers it.
    -->
    <Footer lang={lang} reveal={true} />

    <!-- condensed nav that drops in once the hero is past -->
    <StickyNav lang={lang} altHref={altHref} />

    <div class="page">
      <Nav lang={lang} surface={navSurface} altHref={altHref} />
      <main id="main">
        <slot />
      </main>
    </div>

    <!-- mobile menu; inert and clipped away until opened -->
    <Menu lang={lang} altHref={altHref} />

    <!-- site-wide search over writing and books; inert until opened -->
    <Search lang={lang} />
    <!-- The one audio element for the whole visit. transition:persist makes
         the router move THIS node into every new page instead of replacing
         it, so playback continues across navigation. -->
    <audio data-audio preload="none" transition:persist="audio-el"></audio>

    <!-- tiled grain, replacing the reference's WebGL canvas -->
    <div class="grain" aria-hidden="true"></div>

    <script>
      import '../scripts/scroll';
      import '../scripts/theme';
      import '../scripts/menu';
    </script>
  </body>
</html>
