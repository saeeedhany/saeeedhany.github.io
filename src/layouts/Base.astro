---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/type.css';
import '../styles/components.css';

import Nav from '../components/Nav.astro';
import StickyNav from '../components/StickyNav.astro';
import Footer from '../components/Footer.astro';
import Menu from '../components/Menu.astro';
import { COPY, SITE, THEMES, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** surface of the first band, so the nav can invert to match */
  navSurface?: 'ink' | 'paper';
}

const { lang, title, description, navSurface = 'ink' } = Astro.props;
const t = COPY[lang];
const fullTitle = title ? `${title} — ${SITE.name[lang]}` : SITE.name[lang];
const inks = Object.fromEntries(THEMES.map((th) => [th.id, th.ink]));
---

<!doctype html>
<html lang={lang} dir={t.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content={THEMES[0].ink} />
    <script is:inline define:vars={{ inks }}>
      try {
        var saved = localStorage.getItem('theme');
        if (saved && inks[saved]) {
          document.documentElement.setAttribute('data-theme', saved);
          document.querySelector('meta[name="theme-color"]').setAttribute('content', inks[saved]);
        }
      } catch (e) {}
    </script>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? 'https://saeeedhany.github.io')} />
    <link rel="alternate" hreflang={lang === 'ar' ? 'en' : 'ar'} href={t.otherLangHref} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
  </head>

  <body>
    <!-- the fixed ink border drawn over everything -->
    <div class="frame" aria-hidden="true"></div>

    <!--
      The footer sits OUTSIDE .page and is fixed behind it. .page reserves a
      gap of exactly --footer-h at its end; scrolling into that gap slides the
      content up off the footer and uncovers it.
    -->
    <Footer lang={lang} reveal={true} />

    <!-- condensed nav that drops in once the hero is past -->
    <StickyNav lang={lang} />

    <div class="page">
      <Nav lang={lang} surface={navSurface} />
      <main id="main">
        <slot />
      </main>
    </div>

    <!-- mobile menu; inert and clipped away until opened -->
    <Menu lang={lang} />

    <!-- tiled grain, replacing the reference's WebGL canvas -->
    <div class="grain" aria-hidden="true"></div>

    <script>
      import Lenis from 'lenis';

      const reduce = matchMedia('(prefers-reduced-motion: reduce)');

      // ---- smooth scroll ---------------------------------------------------
      // Lenis drives the real scroll position (it does not transform a
      // wrapper), so the fixed frame, grain and footer keep working.
      let lenis: Lenis | null = null;
      if (!reduce.matches) {
        lenis = new Lenis({
          duration: 1.05,
          easing: (x: number) => 1 - Math.pow(1 - x, 3),
          smoothWheel: true,
          // touch devices already have momentum scrolling; hijacking it makes
          // the page feel worse, not better
          syncTouch: false,
        });

        const raf = (time: number) => {
          lenis!.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);

        // in-page anchors must go through Lenis or they jump
        for (const a of document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) {
          a.addEventListener('click', (e) => {
            const id = a.getAttribute('href')!.slice(1);
            const target = id && document.getElementById(id);
            if (!target) return;
            e.preventDefault();
            lenis!.scrollTo(target, { offset: -24 });
          });
        }
      }

      // ---- scroll-driven custom properties ---------------------------------
      // Same approach as the reference: JS writes numbers into CSS variables,
      // CSS owns every visual decision. No animation library.
      const plates = Array.from(document.querySelectorAll<HTMLElement>('.px'));
      const footer = document.querySelector<HTMLElement>('.footer--reveal');
      const navbar = document.querySelector<HTMLElement>('[data-navbar]');
      const root = document.documentElement;

      // Show the sticky nav once the page's own header is well out of view,
      // and hide it again near the top so it never covers the real header.
      let navShown = false;

      const footerHeight = () =>
        footer ? footer.getBoundingClientRect().height : 0;

      const update = () => {
        const vh = innerHeight;

        if (navbar) {
          const show = scrollY > vh * 0.9;
          if (show !== navShown) {
            navShown = show;
            navbar.dataset.shown = String(show);
            // unreachable while parked above the viewport, reachable once shown
            navbar.inert = !show;
          }
        }

        // footer reveal: how far into the reserved end-gap we've scrolled
        if (footer) {
          const fh = footerHeight();
          const docH = document.documentElement.scrollHeight;
          const gapTop = docH - fh;
          const seen = scrollY + vh - gapTop;
          const p = fh > 0 ? Math.max(0, Math.min(1, seen / fh)) : 0;
          root.style.setProperty('--footer-progress', p.toFixed(4));
          footer.setAttribute('aria-hidden', p < 0.05 ? 'true' : 'false');
        }

        if (reduce.matches) return;

        for (const el of plates) {
          const r = el.getBoundingClientRect();
          if (r.bottom < -200 || r.top > vh + 200) continue;
          const progress = 1 - (r.top + r.height / 2) / (vh / 2 + r.height / 2);
          const drift = Math.max(-1, Math.min(1, progress)) * 34;
          el.style.setProperty('--py', `${drift.toFixed(2)}px`);
        }
      };

      if (lenis) {
        // drive off Lenis's own loop so the values match what is painted
        lenis.on('scroll', update);
      } else {
        let queued = false;
        addEventListener(
          'scroll',
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => {
              queued = false;
              update();
            });
          },
          { passive: true },
        );
      }

      addEventListener('resize', update, { passive: true });
      update();

      // ---- theme ------------------------------------------------------------
      // The saved theme was already applied before first paint by the inline
      // script in <head>; this handles changes and keeps every switch in sync.
      const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

      const syncSwitches = () => {
        const current = root.dataset.theme ?? 'lapis';
        for (const b of document.querySelectorAll<HTMLElement>('[data-theme-set]')) {
          b.setAttribute('aria-pressed', String(b.dataset.themeSet === current));
        }
      };

      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-theme-set]');
        if (!btn) return;
        const id = btn.dataset.themeSet!;
        root.dataset.theme = id;
        if (themeMeta && btn.dataset.ink) themeMeta.content = btn.dataset.ink;
        try {
          localStorage.setItem('theme', id);
        } catch {
          /* private mode or blocked storage: the change still applies */
        }
        syncSwitches();
      });

      syncSwitches();
      // Only now allow --ink to transition. Two frames so the first paint has
      // committed with the saved theme; otherwise it would animate in on load.
      requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add('theme-ready')));

      // ---- menu ---------------------------------------------------------------
      // Opening makes every OTHER top-level element inert, which contains focus
      // inside the dialog without a hand-written focus trap, and stops Lenis so
      // the page underneath can't scroll. Closing restores focus to whichever
      // button opened it.
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      if (menu) {
        const openers = Array.from(document.querySelectorAll<HTMLElement>('[data-menu-open]'));
        const closeBtn = menu.querySelector<HTMLElement>('[data-menu-close]');
        const rest = () =>
          Array.from(document.body.children).filter(
            (el): el is HTMLElement => el !== menu && el instanceof HTMLElement && el.tagName !== 'SCRIPT',
          );
        let returnTo: HTMLElement | null = null;
        // elements that were already inert before opening (the parked sticky
        // bar) must stay inert after closing
        let wasInert = new Set<HTMLElement>();

        const setExpanded = (v: boolean) =>
          openers.forEach((b) => b.setAttribute('aria-expanded', String(v)));

        const open = (from: HTMLElement) => {
          returnTo = from;
          wasInert = new Set(rest().filter((el) => el.inert));
          menu.inert = false;
          menu.dataset.open = 'true';
          setExpanded(true);
          rest().forEach((el) => (el.inert = true));
          root.classList.add('menu-open');
          lenis?.stop();
          // focus once the curtain has started, so the ring doesn't flash first
          setTimeout(() => closeBtn?.focus({ preventScroll: true }), reduce.matches ? 0 : 120);
        };

        const close = (restoreFocus = true) => {
          if (menu.dataset.open !== 'true') return;
          menu.dataset.open = 'false';
          menu.inert = true;
          setExpanded(false);
          rest().forEach((el) => (el.inert = wasInert.has(el)));
          root.classList.remove('menu-open');
          lenis?.start();
          if (restoreFocus) returnTo?.focus({ preventScroll: true });
        };

        openers.forEach((b) => b.addEventListener('click', () => open(b)));
        closeBtn?.addEventListener('click', () => close());
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') close();
        });
        // following a link: let navigation proceed, don't yank focus back
        menu.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) close(false);
        });
        // rotating or resizing into desktop width must never strand it open
        matchMedia('(min-width: 961px)').addEventListener('change', (m) => {
          if (m.matches) close(false);
        });
      }
    </script>
  </body>
</html>
