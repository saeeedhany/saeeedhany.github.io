---
import { getCollection } from 'astro:content';
import PageSearch from './PageSearch.astro';
import { baseFor, COPY, CATEGORY_ORDER, slugOf, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = COPY[lang];
const base = baseFor(lang);

const books = (await getCollection('books', (e) => !e.data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const countIn = (cat: string) => books.filter((b) => b.data.category === cat).length;

const rating = (n?: number) => (n ? '▪'.repeat(n) + '▫'.repeat(5 - n) : '—');
---

<section class="band s-paper">
  <div class="container">
    <div class="head">
      <div class="head__title">
        <h1 class="display display--heading">{t.library}</h1>
      </div>
      <span class="head__link chrome" style="text-decoration: none">
        {String(books.length).padStart(2, '0')}
      </span>
    </div>

    <!-- category filter; the library is already grouped by category, so a
         choice hides the other groups rather than reshuffling rows -->
    <div class="filters" data-filters="books" hidden>
      <PageSearch label={t.searchLibrary} />
      <div class="filters__group" role="group" aria-labelledby="f-cat">
        <span id="f-cat" class="filters__key chrome chrome--intl">{t.filterCategory}</span>
        <div class="chips">
          <button type="button" class="chip" data-f="category" data-v="" aria-pressed="true">
            {t.all} <span class="chip__n" data-n></span>
          </button>
          {
            CATEGORY_ORDER.map((cat) => (
              <button type="button" class="chip" data-f="category" data-v={cat} aria-pressed="false">
                {t.categories[cat]} <span class="chip__n" data-n>{String(countIn(cat)).padStart(2, '0')}</span>
              </button>
            ))
          }
        </div>
      </div>
      <div class="filters__foot">
        <span class="filters__count chrome chrome--intl" aria-live="polite" data-count data-label={t.showing}></span>
        <button type="button" class="filters__clear chrome chrome--intl" data-clear hidden>{t.clear}</button>
      </div>
    </div>

    {
      CATEGORY_ORDER.map((cat) => {
        const items = books.filter((b) => b.data.category === cat);
        if (!items.length) return null;
        return (
          <div style="margin-block-end: var(--s-4xl)" data-group>
            <h2 class="chrome chrome--label chrome--intl" style="margin-block-end: var(--s-l); opacity:.7">
              {t.categories[cat]} · {String(items.length).padStart(2, '0')}
            </h2>
            <div class="rows">
              {items.map((b) => (
                <a
                  class="row"
                  data-item
                  data-category={b.data.category}
                  data-text={[b.data.title, b.data.author, b.data.description ?? '', t.categories[b.data.category], ...b.data.tags].join(' ')}
                  href={`${base}/books/${slugOf(b.id)}`}
                >
                  <span class="row__meta chrome chrome--intl" data-status={b.data.status}>
                    {t.status[b.data.status]}
                  </span>
                  <span>
                    <span class="row__title" dir="auto">{b.data.title}</span>
                    <span class="read" style="display:block; margin-block-start: var(--s-s); opacity:.8">
                      {b.data.author}
                      {b.data.description ? ` — ${b.data.description}` : ''}
                    </span>
                  </span>
                  <span class="row__meta chrome">
                    {rating(b.data.rating)}
                    {b.data.year ? ` · ${b.data.year}` : ''}
                  </span>
                </a>
              ))}
            </div>
          </div>
        );
      })
    }
    <p class="filters__empty read" data-empty hidden>{t.nothingMatches}</p>
  </div>
</section>

<script>
  import { onPage } from '../scripts/lifecycle';
  import { initFilters } from '../scripts/filters';

  onPage('filters:books', () => initFilters('books', { category: (el, v) => el.dataset.category === v }));
</script>
