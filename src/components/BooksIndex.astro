---
import { getCollection } from 'astro:content';
import { baseFor, COPY, CATEGORY_ORDER, slugOf, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = COPY[lang];
const base = baseFor(lang);

const books = (await getCollection('books', (e) => !e.data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const rating = (n?: number) => (n ? '▪'.repeat(n) + '▫'.repeat(5 - n) : '—');
---

<section class="band s-paper">
  <div class="container">
    <div class="head">
      <div class="head__title">
        <h1 class="display display--heading">{t.library}</h1>
      </div>
      <span class="head__link chrome" style="text-decoration: none">
        {String(books.length).padStart(2, '0')}
      </span>
    </div>

    {
      CATEGORY_ORDER.map((cat) => {
        const items = books.filter((b) => b.data.category === cat);
        if (!items.length) return null;
        return (
          <div style="margin-block-end: var(--s-4xl)">
            <h2 class="chrome chrome--label chrome--intl" style="margin-block-end: var(--s-l); opacity:.7">
              {t.categories[cat]} · {String(items.length).padStart(2, '0')}
            </h2>
            <div class="rows">
              {items.map((b) => (
                <a class="row" href={`${base}/books/${slugOf(b.id)}`}>
                  <span class="row__meta chrome chrome--intl" data-status={b.data.status}>
                    {t.status[b.data.status]}
                  </span>
                  <span>
                    <span class="row__title" dir="auto">{b.data.title}</span>
                    <span class="read" style="display:block; margin-block-start: var(--s-s); opacity:.8">
                      {b.data.author}
                      {b.data.description ? ` — ${b.data.description}` : ''}
                    </span>
                  </span>
                  <span class="row__meta chrome">
                    {rating(b.data.rating)}
                    {b.data.year ? ` · ${b.data.year}` : ''}
                  </span>
                </a>
              ))}
            </div>
          </div>
        );
      })
    }
  </div>
</section>
