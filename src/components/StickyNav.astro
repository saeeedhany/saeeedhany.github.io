---
import ThemeSwitch from './ThemeSwitch.astro';
import Burger from './Burger.astro';
import SearchButton from './SearchButton.astro';
import { NAV, SITE, COPY, baseFor, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  /** this same page in the other language */
  altHref: string;
}
const { lang, altHref } = Astro.props;
const t = COPY[lang];
const mark = SITE.mark[lang];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<!--
  Starts `inert`: while parked above the viewport nothing in it can be focused
  or read. The script in Base.astro removes `inert` when the bar drops in.

  It used to be aria-hidden with tabindex=-1 links, which was fine while it only
  duplicated the header. It now carries the mobile menu button once the header
  has scrolled away, so it has to be a real, reachable navigation when shown.
-->
<div class="navbar" data-navbar data-shown="false" inert>
  <div class="navbar__inner s-paper">
    <div class="container">
      <div class="navbar__row">
        <a class="navbar__mark" href={baseFor(lang) || '/'}>
          {mark[0]} {mark[1]}
        </a>

        <div class="navbar__end">
          <nav class="navbar__links" aria-label={lang === 'ar' ? 'تنقل سريع' : 'Quick navigation'}>
            {
              NAV.map((item) => (
                <a
                  class="nav__link ui"
                  href={item.href[lang]}
                  aria-current={isCurrent(item.href[lang]) ? 'page' : undefined}
                >
                  {item.label[lang]}
                </a>
              ))
            }
            <a class="nav__link chrome" href={altHref} lang={lang === 'ar' ? 'en' : 'ar'}>
              {t.otherLang}
            </a>
          </nav>
          <SearchButton lang={lang} />
          <ThemeSwitch lang={lang} class="navbar__theme" />
          <Burger lang={lang} class="navbar__burger" />
        </div>
      </div>
    </div>
  </div>
</div>
