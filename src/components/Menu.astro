---
import SocialIcons from './SocialIcons.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import SearchButton from './SearchButton.astro';
import { SITE, COPY, homeHref, type Lang } from '../data/site';
import { getNav } from '../data/nav';

interface Props {
  lang: Lang;
  altHref: string;
}
const { lang, altHref } = Astro.props;
const nav = await getNav(lang, Astro.url.pathname);
const t = COPY[lang];
const mark = SITE.mark[lang];
---

<div
  class="menu s-ink"
  id="site-menu"
  data-menu
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-label={t.menu}
  inert
>
  <div class="menu__plate duo" aria-hidden="true">
    <img src="/plates/optics-diagram.png" alt="" loading="lazy" decoding="async" />
  </div>

  <div class="menu__body container">
    <div class="menu__bar">
      <a class="menu__mark" href={homeHref(lang)}>
        {mark[0]}
        <br />
        {mark[1]}
      </a>
      <button type="button" class="menu__close" data-menu-close>
        <span class="burger__label ui">{t.close}</span>
        <span class="menu__x" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>

    <div class="menu__search" style="--i: 0">
      <SearchButton lang={lang} variant="bar" />
    </div>

    <nav class="menu__nav" aria-label={t.menu}>
      <ol class="menu__list">
        {nav.map((item, i) => (
          <li class="menu__item" style={`--i: ${i}`}>
            <a class="menu__link" href={item.href} aria-current={item.current ? 'page' : undefined}>
              <span class="menu__index chrome">{String(i + 1).padStart(2, '0')}</span>
              <span class="menu__mask">
                <span class="menu__label display">{item.label}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="menu__foot" style={`--i: ${nav.length}`}>
      <div class="menu__row">
        <span class="chrome chrome--intl menu__key">{t.theme}</span>
        <ThemeSwitch lang={lang} class="theme-switch--lg" />
      </div>
      <div class="menu__row">
        <span class="chrome chrome--intl menu__key">{t.elsewhere}</span>
        <SocialIcons size={18} class="socials--lg" />
      </div>
      <div class="menu__row">
        <a class="chrome menu__lang" href={altHref} lang={lang === 'ar' ? 'en' : 'ar'}>
          {t.otherLang}
        </a>
        <a class="chrome menu__email" href={`mailto:${SITE.email}`}>
          {SITE.email}
        </a>
      </div>
    </div>
  </div>
</div>
