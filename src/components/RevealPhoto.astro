---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  mask: ImageMetadata;
  alt: string;
  ratio: string;
  sizes: string;
  eager?: boolean;
}
const { image, mask, alt, ratio, sizes, eager = false } = Astro.props;
// the mask at its own size, lossless: resampling or lossy encoding ruins a dither
const m = await getImage({ src: mask, width: mask.width, format: 'png' });
---

<figure class="px reveal" data-reveal style="margin: 0">
  <div class="plate duo tile__frame" style={`aspect-ratio: ${ratio}`}>
    <img
      class="tile__mask"
      src={m.src}
      alt=""
      width={mask.width}
      height={mask.height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    <Image
      class="tile__colour"
      src={image}
      widths={[480, 800, 1024]}
      sizes={sizes}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
</figure>

<script>
  import '../scripts/reveal';
</script>
