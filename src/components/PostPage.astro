---
import { render } from 'astro:content';
import Essay from '../layouts/Essay.astro';
import { plateFor, postCanonical, type Post } from '../data/posts';
import type { Lang } from '../data/site';

interface Props {
  lang: Lang;
  post: Post;
  rank: number;
  number: string;
}
const { lang, post, rank, number } = Astro.props;
const { Content } = await render(post);
const canonical = postCanonical(post);
---

<Essay
  lang={lang}
  contentLang={post.data.lang}
  title={post.data.title}
  date={post.data.date}
  description={post.data.description}
  tags={[...post.data.tags]}
  plate={plateFor(post, rank)}
  index={number}
  canonical={canonical}
  audio={post.data.audio}
  href={canonical}
>
  <Content />
</Essay>
